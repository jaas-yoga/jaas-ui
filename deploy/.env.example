# Copy to .env and fill in real values. Never commit .env.

# Public DNS names, both pointed (A record) at this VM's public IP before
# starting the stack — Caddy issues Let's Encrypt certs for both on first
# request, which requires them to already resolve and ports 80/443 to be
# reachable from the internet.
DOMAIN=jaas.example.com
API_DOMAIN=api.jaas.example.com

# Auth.js session encryption key. Generate with: openssl rand -base64 33
AUTH_SECRET=

# Dedicated Google OAuth client for this app, from
# https://console.cloud.google.com/apis/credentials. Authorized redirect
# URI on this client must be:
#   https://<DOMAIN>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# jaas-registry's session-token signing secret — overrides config.py's
# insecure dev default. Generate with: openssl rand -hex 32
JAAS_JWT_SECRET=

# Optional Google-free alternative: enables "Sign in with email" for the
# two seeded accounts (owner@jaas.local, admin@jaas.local). Leave unset to
# keep it disabled.
JAAS_DEV_LOGIN_PASSWORD=
