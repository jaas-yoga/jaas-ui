# Copy to .env and fill in real values. Never commit .env.

# Public DNS names, both pointed (A record) at this VM's public IP before
# starting the stack — Caddy issues Let's Encrypt certs for both on first
# request, which requires them to already resolve and ports 80/443 to be
# reachable from the internet.
DOMAIN=jaas.example.com
API_DOMAIN=api.jaas.example.com

# Auth.js session encryption key. Generate with: openssl rand -base64 33
AUTH_SECRET=

# Dedicated Google OAuth client for this app, from
# https://console.cloud.google.com/apis/credentials. Authorized redirect
# URI on this client must be:
#   https://<DOMAIN>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# jaas-registry's session-token signing secret — overrides config.py's
# insecure dev default. Generate with: openssl rand -hex 32
JAAS_JWT_SECRET=

# Optional Google-free alternative: enables "Sign in with email" for the
# two seeded accounts (owner@jaas.local, admin@jaas.local). Leave unset to
# keep it disabled.
JAAS_DEV_LOGIN_PASSWORD=

# Object storage backend for published skill artifacts. Leave everything
# below unset to keep the "local" default (a Docker volume on this VM —
# fine for a single instance, but not durable beyond it). Set
# JAAS_STORAGE_BACKEND=s3 to switch to OCI Object Storage's Always Free
# tier (or any other S3-compatible bucket) instead:
#
#   1. OCI Console -> Storage -> Object Storage & Archive Storage ->
#      Buckets -> Create Bucket (Standard tier). Note the bucket name and
#      the "namespace" shown at the top of the Buckets page.
#   2. OCI Console -> your username (top right) -> Customer Secret Keys ->
#      Generate Secret Key. The Access Key becomes
#      JAAS_STORAGE_S3_ACCESS_KEY_ID; the Secret Key (shown once) becomes
#      JAAS_STORAGE_S3_SECRET_ACCESS_KEY.
#   3. Endpoint is https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
#      — e.g. https://axabc123xyz.compat.objectstorage.us-ashburn-1.oraclecloud.com
JAAS_STORAGE_BACKEND=local
JAAS_STORAGE_S3_BUCKET=
JAAS_STORAGE_S3_ENDPOINT_URL=
JAAS_STORAGE_S3_REGION=us-ashburn-1
JAAS_STORAGE_S3_ACCESS_KEY_ID=
JAAS_STORAGE_S3_SECRET_ACCESS_KEY=
